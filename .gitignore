# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local virtual environments
.venv/
venv/
env/

# Editor and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*~

# Generated figures and image artifacts
*.fig
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
*.tiff
*.webp
*.svg
*.eps

# Transient simulator execution state (preserve scenario inputs and result data)
/Simulation/Architecture/simulator/runs/**/logs/
/Simulation/Architecture/simulator/runs/**/parts/
/Simulation/Architecture/simulator/runs/**/archive/
/Simulation/Architecture/simulator/runs/**/launcher.pid
/Simulation/Architecture/simulator/runs/**/monitor_progress.py
/Simulation/Architecture/simulator/runs/**/start_all_*.sh
/Simulation/Architecture/simulator/runs/**/_trial_journal.jsonl
/Simulation/Architecture/simulator/runs/**/_FAILED.txt
/Simulation/Architecture/simulator/runs/**/_COMPLETE.txt

# Generated hardware replay captures and partial sensitivity shards remain local.
/Results/HIL/AllocatorReplay/
/Results/Simulation/Sensitivity/_cv100/
/Simulation/Architecture/allocator_replay/builds/

# Local junction to the separately versioned collaborative simulator repository.
/Simulation/dcta_benchmark_sim/
